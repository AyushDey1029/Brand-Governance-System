# Inkloom AI Brand Governance Platform Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Gemini API Configuration (Optional: uses offline deterministic engine if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_TEXT=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Vector Knowledge Base Configuration
# Options: "in_memory" (default, zero extra setup), "qdrant", or "pinecone"
VECTOR_DB_PROVIDER=in_memory
RAG_TOP_K=3

# Optional: Qdrant Vector DB
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here

# Optional: Pinecone Vector DB
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX_NAME=inkloom-golden-facts

# Supabase Configuration (Optional - provides cloud database + pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key

# Brand Colors (Hex code for primary brand palette check)
BRAND_PRIMARY_HEX=#4F46E5
BRAND_SECONDARY_HEX=#06B6D4
COLOR_TOLERANCE=35.0
