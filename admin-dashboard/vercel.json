{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://brand-governance-system-17bz.vercel.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://brand-governance-system-17bz.vercel.app/health"
    },
    {
      "source": "/test-draft",
      "destination": "https://brand-governance-system-17bz.vercel.app/test-draft"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
